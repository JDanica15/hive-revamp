# Public origin of the site, used for canonical URLs, Open Graph tags, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=https://hivebpo.com

# Supabase (Dashboard → Project Settings → API Keys). Stores job listings, inquiries,
# applications and resumes, and handles the /admin login. The secret key has full access to the
# database: keep it private and never give it a NEXT_PUBLIC_ name. Without these, the site shows
# the jobs in src/data/jobs.json and the forms and admin panel are disabled.
# (The older names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Who may use /admin: comma-separated emails of Supabase users you've created.
ADMIN_EMAILS=you@example.com

# Optional search console verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
