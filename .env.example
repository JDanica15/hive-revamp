# Public origin of the site, used for canonical URLs, Open Graph tags, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=https://hivebpo.com

# Supabase (Dashboard → Project Settings → API Keys). Stores job listings, inquiries,
# applications and resumes, and handles the /admin login. The secret key has full access to the
# database: keep it private and never give it a NEXT_PUBLIC_ name. Without these, the site shows
# the jobs in src/data/jobs.json and the forms and admin panel are disabled.
# (The older names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Who may use /admin: comma-separated emails of Supabase users you've created.
ADMIN_EMAILS=you@example.com

# Optional search console verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Blog writing agent (Google Gemini) -------------------------------------------------------
# Create a key at https://aistudio.google.com (the key icon). Server only: never give it a
# NEXT_PUBLIC_ name and never commit it. Without it, the admin Blog page can't write posts.
GEMINI_API_KEY=
# Optional: models to try, in order, comma separated (the next is used when one is busy or retired).
# Leave unset to use the tested defaults. "Check Gemini connection" on the admin Blog page tests each one.
# NOTE: cover images need billing turned on for the key's Google project (the free tier has no image quota).
GEMINI_TEXT_MODELS=
GEMINI_IMAGE_MODELS=
# Cover images are OFF by default. Set to true only after billing is on for the key's Google project,
# and re-add the /api/blog/images cron to vercel.json.
BLOG_IMAGES=
# Protects the scheduled writer (/api/blog/generate). Any long random string; Vercel Cron sends it
# automatically as "Authorization: Bearer <value>". Without it the schedule does nothing.
CRON_SECRET=
# Leave unset: new posts are saved as drafts for you to review. Set to "true" ONLY if you want the
# agent to publish straight to the site (AI can state things that aren't true).
BLOG_AUTO_PUBLISH=
