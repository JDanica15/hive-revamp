# Public origin of the site, used for canonical URLs, Open Graph tags, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=https://hivebpo.com

# Supabase (Dashboard → Project Settings → API). Stores job listings, inquiries, applications
# and resumes, and handles the /admin login. Keep the service role key secret: never prefix it
# with NEXT_PUBLIC_. Without these, the site shows the jobs in src/data/jobs.json and the
# forms and admin panel are disabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who may use /admin: comma-separated emails of Supabase users you've created.
ADMIN_EMAILS=you@example.com

# Optional search console verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
